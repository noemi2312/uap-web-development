generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  reviews   Review[]
  createdAt DateTime @default(now())
}

model Review {
  id        String   @id @default(uuid())
  bookId    String
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  rating    Int
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
